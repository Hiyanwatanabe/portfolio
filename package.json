{
  "name": "hiyan-kubagawa-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "homepage": "https://hiyanwatanabe.github.io/portfolio",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "playwright test",
    "check": "npm run lint && npm run build && npm run test",
    "deploy": "npm run build && wrangler pages deploy dist --project-name hiyaners --branch main --commit-dirty=true",
    "deploy:github-redirect": "gh-pages -d redirect --nojekyll -m \"Redirect to hiyaners.pages.dev\""
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.27.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.27.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "gh-pages": "^6.3.0",
    "globals": "^16.1.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "wrangler": "^4.157.0"
  }
}
